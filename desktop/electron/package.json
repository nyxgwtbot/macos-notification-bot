{
  "name": "notifybot-desktop-electron",
  "version": "1.0.0",
  "description": "Electron desktop shell for the macOS Notification Bot",
  "author": {
    "name": "",
    "email": ""
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc",
    "electron:start": "npm run build && electron ./",
    "electron:start-live": "node ./live-runner.js",
    "electron:start-debug": "npm run build && electron --remote-debugging-port=9223 --user-data-dir=./tmp-profile ./"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^26.2.2",
    "electron-builder": "~23.6.0",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ]
}